<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional per-process diagnostic transport, Fast DDS 2.6.x.
     No IP, route, firewall, QoS or watchdog changes. No global installation.
     Reference: https://fast-dds.docs.eprosima.com/en/2.6.x/fastdds/transport/udp/udp.html -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>localization_ab_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="localization_ab_udp_only" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>localization_ab_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
